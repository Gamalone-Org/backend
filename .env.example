# Environment
NODE_ENV=development

# Server
PORT=5000
API_PUBLIC_URL=http://localhost:5000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gamalone_backend

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Redis (optional, for caching and async features)
REDIS_URL=

# Cloudinary (optional, for media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS
CORS_ORIGINS=http://localhost:5000,http://localhost:3000,http://localhost:5173,http://localhost:4173

# SMS provider configuration
# Supported providers: mock, afriksms, twilio, messagebird, custom
SMS_PROVIDER=mock

# AfrikSMS configuration (when SMS_PROVIDER=afriksms)
# Get credentials from https://afriksms.com/docapi
SMS_CLIENT_ID=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_BASE_URL=https://api.afriksms.com/api/web/web_v1/outbounds

# Twilio configuration (when SMS_PROVIDER=twilio)
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=

# Other providers
SMS_FROM=
SMS_API_SECRET=

# General SMS settings
SMS_TIMEOUT_MS=10000

# OTP security configuration
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_RATE_LIMIT_PER_PHONE=5
OTP_RATE_LIMIT_PER_IP=20
