# Environment
NODE_ENV=development

# Server
PORT=5000
API_PUBLIC_URL=http://localhost:5000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gamalone_backend

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Redis (optional, for caching and async features)
REDIS_URL=

# Cloudinary (required in production for KYC documents)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# KYC retention and signed URL security
# KYC_RETENTION_DAYS: retention period in days (30-3650, default 365). Required in production.
# KYC_SIGNED_URL_TTL: signed URL lifetime in seconds (60-3600, default 900). Required in production.
KYC_RETENTION_DAYS=365
KYC_SIGNED_URL_TTL=900

# CORS
CORS_ORIGINS=http://localhost:5000,http://localhost:3000,http://localhost:5173,http://localhost:4173,https://gamalone-frontend.vercel.app

# SMS provider configuration
# Supported providers: mock, afriksms, twilio, messagebird, custom
SMS_PROVIDER=mock

# AfrikSMS configuration (when SMS_PROVIDER=afriksms)
# Get credentials from https://afriksms.com/docapi
SMS_CLIENT_ID=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_BASE_URL=https://api.afriksms.com/api/web/web_v1/outbounds

# Twilio configuration (when SMS_PROVIDER=twilio)
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=

# Other providers
SMS_FROM=
SMS_API_SECRET=

# General SMS settings
SMS_TIMEOUT_MS=10000

# OTP security configuration
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_RATE_LIMIT_PER_PHONE=5
OTP_RATE_LIMIT_PER_IP=20

# Vercel Cron secret for the KYC retention purge job.
# When set, Vercel automatically sends it as `Authorization: Bearer <CRON_SECRET>`
# on cron invocations of /api/v1/internal/kyc/purge/cron.
# Leave empty to disable the automatic purge.
CRON_SECRET=

# Bootstrap du premier SUPER_ADMIN (seed Prisma : npm run db:seed).
# Téléphone et mot de passe sont OBLIGATOIRES. Le mot de passe n'est JAMAIS
# affiché ni journalisé (seulement transporté par cette variable). Le seed
# refuse de s'exécuter si un SUPER_ADMIN actif existe déjà.
# → VARIABLES L.UES PAR LE SEED PRISMA :
#   BOOTSTRAP_ADMIN_TELEPHONE (requis)
#   BOOTSTRAP_ADMIN_PASSWORD  (requis, secret, jamais de valeur par défaut)
#   BOOTSTRAP_ADMIN_USERNAME  (optionnel ; valeur officielle par défaut = g.apedo,
#                              identifiant public non secret)
#   BOOTSTRAP_ADMIN_EMAIL     (optionnel)
#   BOOTSTRAP_ADMIN_NOM / BOOTSTRAP_ADMIN_DEPARTEMENT (optionnels)
# username : nom d'utilisateur de connexion, 3-30 caractères (a-z, 0-9, . - _),
# en minuscules, sans espace ni séparateur en début/fin.
BOOTSTRAP_ADMIN_TELEPHONE=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_USERNAME=g.apedo
BOOTSTRAP_ADMIN_NOM=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_DEPARTEMENT=

# - CLI HISTORIQUE (npm run bootstrap:super-admin, tools/) : lit
#   BOOTSTRAP_ADMIN_MOTDEPASSE à la place de BOOTSTRAP_ADMIN_PASSWORD. Documents
#   d'archive, gardés pour compatibilité ; le seed Prisma, lui, utilise PASSWORD.
BOOTSTRAP_ADMIN_MOTDEPASSE=
