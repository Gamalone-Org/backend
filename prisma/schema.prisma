// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIF
  INACTIF
  SUSPENDU
  EN_ATTENTE_VALIDATION
}

enum UserRole {
  ACHETEUR
  ARTISAN
  ADMIN
}

enum PhoneVerificationStatus {
  NON_VERIFIE
  EN_ATTENTE_VERIFICATION
  VERIFIE
  BLOQUE
}

enum ArtisanSubscription {
  GRATUIT
  STANDARD
  PREMIUM
}

enum ArtisanType {
  ARTISAN
  ARTISTE
}

enum AdminAccessLevel {
  SUPPORT
  MODERATEUR
  SUPER_ADMIN
}

// ---------------------------------------------------------------------------
// Permissions granulaires des administrateurs.
// SUPPORT / MODERATEUR = ADMIN "simple" : accès conditionné aux permissions
// attribuées. SUPER_ADMIN = accès implicite total (OPTION A : le SUPER_ADMIN
// ne stocke pas de permissions, il les possède toutes par nature).
// ---------------------------------------------------------------------------

enum AdminPermission {
  ADMINS_READ
  ADMINS_CREATE
  ADMINS_UPDATE
  ADMINS_MANAGE
  USERS_READ
  USERS_UPDATE
  ARTISANS_READ
  ARTISANS_UPDATE
  KYC_READ
  KYC_REVIEW
  KYC_VALIDATE
  ARTWORKS_READ
  ARTWORKS_CREATE
  ARTWORKS_UPDATE
  ARTWORKS_DELETE
  ARTWORKS_PUBLISH
  CATEGORIES_READ
  CATEGORIES_MANAGE
  ORDERS_READ
  ORDERS_UPDATE
  DISPUTES_READ
  DISPUTES_MANAGE
  ARTICLES_READ
  ARTICLES_CREATE
  ARTICLES_UPDATE
  ARTICLES_DELETE
  ARTICLES_PUBLISH
  DELIVERIES_READ
  DELIVERIES_UPDATE
  REVIEWS_READ
  DASHBOARD_READ
}

// ---------------------------------------------------------------------------
// Actions sensibles d'administration tracées (audit minimal, hors champ RGPD
// des données métier : on ne log que des références + du Json non sensible).
// ---------------------------------------------------------------------------

enum AdminAuditAction {
  CREATE_ADMIN
  UPDATE_ADMIN
  UPDATE_ADMIN_PERMISSIONS
  ACTIVATE_ADMIN
  DEACTIVATE_ADMIN
}

enum BuyerType {
  PARTICULIER
  PROFESSIONNEL
  COLLECTIONNEUR
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  PHONE_VERIFICATION
}

enum OtpStatus {
  EN_ATTENTE
  UTILISE
  EXPIRE
  BLOQUE
}

enum KycStatus {
  BROUILLON
  SOUMIS
  EN_ATTENTE
  VALIDE
  REJETE
  CORRECTION_REQUISE
  EXPIRE
}

enum KycReviewAction {
  APPROUVER
  REJETER
  DEMANDE_CORRECTION
}

enum KycDocumentType {
  CNI_RECTO
  CNI_VERSO
  PASSEPORT
  TITRE_SEJOUR
  JUSTIFICATIF_DOMICILE
  PHOTO_SELFIE
  EXTRAIT_KBIS
  DOCUMENT_COMPLEMENTAIRE
}

enum ArtworkStatus {
  BROUILLON
  EN_ATTENTE_VALIDATION
  PUBLIEE
  EN_PANIER
  VENDUE
  RETIREE
}

enum ArtworkAvailability {
  DISPONIBLE
  SUR_COMMANDE
  EN_EXPOSITION
}

enum MediaType {
  OEUVRE
  PREPARATION
  ATELIER
}

enum OrderStatus {
  COMMANDE
  PREPARATION
  EXPEDIEE
  LIVREE
  CLOTUREE
  ANNULEE
  REMBOURSEE
}

enum OrderType {
  STANDARD
  SUR_MESURE
  ENCHERE
}

enum PaymentMethod {
  CARTE_BANCAIRE
  MOBILE_MONEY
  VIREMENT
  ESPECES
}

enum PaymentStatus {
  EN_ATTENTE
  EN_COURS
  REUSSI
  ECHOUE
  REMBOURSE
}

enum DeliveryStatus {
  EN_ATTENTE
  PREPAREE
  EXPEDIEE
  EN_TRANSIT
  LIVREE
  ECHEC
}

enum ArtisanDevise {
  XOF
  EUR
  USD
}

enum ArtisanLangue {
  fr
  en
}

enum ArtisanPaiementMethode {
  MOBILE_MONEY
  VIREMENT_BANCAIRE
}

// ---------------------------------------------------------------------------
// Utilisateur (base) + profils métier (remplace l'héritage UML)
// ---------------------------------------------------------------------------

model User {
  id                          String                  @id @default(uuid()) @db.Uuid
  email                       String?                 @unique
  nom                         String?
  motDePasse                  String?
  telephone                   String                  @unique
  statut                      UserStatus              @default(EN_ATTENTE_VALIDATION)
  role                        UserRole                @default(ACHETEUR)
  telephoneVerificationStatus PhoneVerificationStatus @default(NON_VERIFIE)
  telephoneVerifiedAt         DateTime?
  anonymizedAt                DateTime?
  deletedAt                   DateTime?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt

  artisanProfile ArtisanProfile?
  adminProfile   AdminProfile?
  buyerProfile   BuyerProfile?
  otpCodes       OtpCode[]
  kycSubmissions Kyc[]

  @@index([telephone])
  @@index([anonymizedAt])
  @@index([deletedAt])
  @@map("users")
}

model ArtisanProfile {
  id                  String              @id @default(uuid()) @db.Uuid
  userId              String              @unique @db.Uuid
  type                ArtisanType         @default(ARTISAN)
  nomAtelier          String
  specialite          String
  biographie          String              @db.Text
  localisation        String
  anneesExperience    Int
  estCertifie         Boolean             @default(false)
  scoreFiabilite      Decimal?            @db.Decimal(5, 2)
  liensReseauxSociaux Json?               @db.JsonB
  abonnement          ArtisanSubscription @default(GRATUIT)
  commission          Decimal             @default(0) @db.Decimal(5, 2)
  validatedByAdminId  String?             @db.Uuid
  validatedAt         DateTime?
  photoAtelierUrl     String?
  photoAtelierPublicId String?
  photoAtelierMimeType String?
  photoAtelierSize    Int?

  // --- Photo de profil artisan ---
  photoProfilUrl        String?
  photoProfilPublicId   String?
  photoProfilMimeType   String?
  photoProfilSize       Int?

  // --- Bannière atelier ---
  photoBanniereUrl        String?
  photoBannierePublicId   String?
  photoBanniereMimeType   String?
  photoBanniereSize       Int?

  // --- Informations étendues ---
  anneeCreation       Int?
  ville               String?
  pays                String?

  // --- Présentation ---
  bioCourte           String?             @db.VarChar(500)
  histoire            String?             @db.Text
  siteWeb             String?

  // --- Paramètres boutique ---
  devise              ArtisanDevise       @default(XOF)
  langue              ArtisanLangue       @default(fr)
  preparationMinDays  Int?
  preparationMaxDays  Int?

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  validatedByAdmin AdminProfile?   @relation("ArtisanKycValidation", fields: [validatedByAdminId], references: [id], onDelete: SetNull)
  oeuvres          Oeuvre[]
  lignesCommande   LigneCommande[]
  commandesArtisans CommandeArtisan[]
  litiges          Litige[]
  atelierPhotos    ArtisanAtelierPhoto[]
  processusEtapes  CreationProcessus[]
  expositions      Exposition[]
  boutiqueSetting  BoutiqueSetting?
  paiementPreference ArtisanPaymentPreference?

  @@index([validatedByAdminId])
  @@map("artisan_profiles")
}

model AdminProfile {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @unique @db.Uuid
  niveauAcces AdminAccessLevel @default(SUPPORT)
  departement String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  validatedArtisans ArtisanProfile[]   @relation("ArtisanKycValidation")
  publishedOeuvres  Oeuvre[]           @relation("OeuvrePublication")
  reviewedKycs      Kyc[]              @relation("AdminKycReview")
  reviewHistories   KycReviewHistory[] @relation("AdminKycReviewHistory")
  articles          Article[]          @relation("ArticlePublication")
  authoredArticles  Article[]          @relation("ArticleAuthor")
  permissions       AdminProfilePermission[]
  auditLogsAsActor  AdminAuditLog[]     @relation("AdminAuditActor")
  auditLogsAsTarget AdminAuditLog[]     @relation("AdminAuditTarget")

  @@map("admin_profiles")
}

// ---------------------------------------------------------------------------
// Permissions d'un profil administrateur (many-to-many implicite : un ADMIN
// possède N permissions, données par le SUPER_ADMIN). La clé composite
// garantit l'absence de doublon pour un même profil.
// ---------------------------------------------------------------------------

model AdminProfilePermission {
  adminProfileId String         @db.Uuid
  permission     AdminPermission
  createdAt      DateTime       @default(now())

  adminProfile AdminProfile @relation(fields: [adminProfileId], references: [id], onDelete: Cascade)

  @@id([adminProfileId, permission])
  @@index([permission])
  @@map("admin_profile_permissions")
}

// ---------------------------------------------------------------------------
// Audit minimal des actions d'administration sensibles (création, modification,
// attributions, activation/désactivation). Les référentiels de permission
// (`AdminPermission`) et de niveau sont stockés en texte/Json, jamais les
// mots de passe ni les données sensibles des utilisateurs.
// ---------------------------------------------------------------------------

model AdminAuditLog {
  id            String           @id @default(uuid()) @db.Uuid
  action        AdminAuditAction
  actorAdminId  String?          @db.Uuid
  targetAdminId String?          @db.Uuid
  details       Json?            @db.JsonB
  createdAt     DateTime         @default(now())

  actorAdmin  AdminProfile? @relation("AdminAuditActor", fields: [actorAdminId], references: [id], onDelete: SetNull)
  targetAdmin AdminProfile? @relation("AdminAuditTarget", fields: [targetAdminId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([actorAdminId])
  @@index([targetAdminId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model BuyerProfile {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @unique @db.Uuid
  adresseLivraison String
  devise           String    @default("XOF")
  langue           String    @default("fr")
  typeClient       BuyerType @default(PARTICULIER)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  commandes Commande[]
  favoris    Favori[]

  @@map("buyer_profiles")
}

// ---------------------------------------------------------------------------
// Favoris acheteur (Espace Acheteur → Mes favoris).
// Un acheteur ne peut mettre une même œuvre en favori qu'une seule fois.
// La contrainte unique composite (acheteurId, oeuvreId) est la protection
// finale contre les doublons (y compris en cas de concurrence).
// ---------------------------------------------------------------------------

model Favori {
  id           String   @id @default(uuid()) @db.Uuid
  acheteurId   String   @db.Uuid
  oeuvreId     String   @db.Uuid
  dateCreation DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  acheteur BuyerProfile @relation(fields: [acheteurId], references: [id], onDelete: Cascade)
  oeuvre   Oeuvre       @relation(fields: [oeuvreId], references: [id], onDelete: Cascade)

  @@unique([acheteurId, oeuvreId])
  @@index([acheteurId, dateCreation])
  @@map("favoris")
}

model OtpCode {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String?    @db.Uuid
  phone        String
  codeHash     String
  purpose      OtpPurpose
  status       OtpStatus  @default(EN_ATTENTE)
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
  usedAt       DateTime?
  attemptCount Int        @default(0)
  maxAttempts  Int        @default(5)
  lastSentAt   DateTime?
  updatedAt    DateTime   @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, purpose, status])
  @@index([userId])
  @@map("otp_codes")
}

model Kyc {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  status            KycStatus @default(BROUILLON)
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewedByAdminId String?   @db.Uuid
  rejectionReason   String?
  resubmissionOfId  String?   @db.Uuid

  identityData     Json?
  professionData   Json?
  additionalInfo   Json?
  addressData      Json?
  identityDocument Json?
  supportingDocs   Json?

  retentionUntil DateTime?
  anonymizedAt   DateTime?
  deletedAt      DateTime?
  legalHold      Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  reviewedByAdmin AdminProfile? @relation("AdminKycReview", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  previousSubmission Kyc?               @relation("KycResubmission", fields: [resubmissionOfId], references: [id], onDelete: SetNull)
  resubmissions      Kyc[]              @relation("KycResubmission")
  documents          KycDocument[]
  reviewHistory      KycReviewHistory[]

  @@index([userId, status])
  @@index([reviewedByAdminId])
  @@index([retentionUntil])
  @@index([deletedAt])
  @@index([anonymizedAt])
  @@index([legalHold])
  @@map("kyc_records")
}

model KycReviewHistory {
  id        String          @id @default(uuid()) @db.Uuid
  kycId     String          @db.Uuid
  adminId   String?         @db.Uuid
  action    KycReviewAction
  reason    String?         @db.Text
  createdAt DateTime        @default(now())

  adminProfileIdSnapshot   String?           @db.Uuid
  adminDepartementSnapshot String?
  adminNiveauAccesSnapshot AdminAccessLevel?

  kyc   Kyc           @relation(fields: [kycId], references: [id], onDelete: Restrict)
  admin AdminProfile? @relation("AdminKycReviewHistory", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([kycId])
  @@index([adminId])
  @@index([adminProfileIdSnapshot])
  @@map("kyc_review_history")
}

model KycDocument {
  id           String          @id @default(uuid()) @db.Uuid
  kycId        String          @db.Uuid
  documentType KycDocumentType

  // --- Référence Cloudinary (jamais le binaire, uniquement les métadonnées) ---
  secureUrl    String
  publicId     String
  resourceType String
  format       String?
  bytes        Int
  assetId      String?

  retentionUntil DateTime?
  anonymizedAt   DateTime?
  deletedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kyc Kyc @relation(fields: [kycId], references: [id], onDelete: Restrict)

  @@index([kycId])
  @@index([kycId, documentType])
  @@index([retentionUntil])
  @@index([deletedAt])
  @@map("kyc_documents")
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum ArticleStatus {
  BROUILLON
  PLANIFIE
  PUBLIE
}

model Categorie {
  id                      String         @id @default(uuid()) @db.Uuid
  nom                     String         @unique
  description             String         @db.Text
  slug                    String         @unique
  imageCouvertureUrl      String?
  imageCouverturePublicId String?
  statut                  CategoryStatus @default(ACTIVE)
  position                Int            @default(0)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  oeuvres        Oeuvre[]
  sousCategories SousCategorie[]
  articles       Article[]

  @@index([slug])
  @@index([statut])
  @@map("categories")
}

model SousCategorie {
  id                      String         @id @default(uuid()) @db.Uuid
  nom                     String
  description             String         @db.Text
  slug                    String         @unique
  imageCouvertureUrl      String?
  imageCouverturePublicId String?
  statut                  CategoryStatus @default(ACTIVE)
  position                Int            @default(0)
  categorieId             String         @db.Uuid
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  categorie Categorie @relation(fields: [categorieId], references: [id], onDelete: Restrict)

  @@unique([categorieId, nom])
  @@index([categorieId])
  @@index([slug])
  @@map("sous_categories")
}

model Oeuvre {
  id                 String        @id @default(uuid()) @db.Uuid
  titre              String
  description        String        @db.Text
  technique          String
  materiaux          String
  dimensions         String
  poids              Float?
  anneeCreation      Int
  prixXOF            Decimal       @db.Decimal(12, 0)
  statut             ArtworkStatus @default(BROUILLON)
  disponibilite      ArtworkAvailability @default(DISPONIBLE)
  artisanId          String        @db.Uuid
  categorieId        String        @db.Uuid
  publishedByAdminId String?       @db.Uuid
  rejectionReason    String?
  estMiseEnAvant     Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  artisan          ArtisanProfile  @relation(fields: [artisanId], references: [id], onDelete: Restrict)
  categorie        Categorie       @relation(fields: [categorieId], references: [id], onDelete: Restrict)
  publishedByAdmin AdminProfile?   @relation("OeuvrePublication", fields: [publishedByAdminId], references: [id], onDelete: SetNull)
  medias           Media[]
  certificat       Certificat?
  lignesCommande   LigneCommande[]
  favoris          Favori[]

  @@index([artisanId])
  @@index([categorieId])
  @@index([statut])
  @@index([disponibilite])
  @@index([estMiseEnAvant])
  @@map("oeuvres")
}

model Media {
  id        String    @id @default(uuid()) @db.Uuid
  url       String
  publicId  String
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  ordre     Int       @default(0)
  type      MediaType @default(OEUVRE)
  oeuvreId  String    @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  oeuvre Oeuvre @relation(fields: [oeuvreId], references: [id], onDelete: Cascade)

  @@index([oeuvreId])
  @@index([oeuvreId, ordre])
  @@index([oeuvreId, type])
  @@map("media")
}

model Certificat {
  id           String   @id @default(uuid()) @db.Uuid
  codeQR       String   @unique
  dateEmission DateTime @default(now())
  hashOeuvre   String
  estValide    Boolean  @default(true)
  oeuvreId     String   @unique @db.Uuid

  oeuvre Oeuvre @relation(fields: [oeuvreId], references: [id], onDelete: Cascade)

  @@map("certificats")
}

// ---------------------------------------------------------------------------
// Éditorial / Articles
// ---------------------------------------------------------------------------

model Article {
  id                  String        @id @default(uuid()) @db.Uuid
  titre               String
  contenu             String        @db.Text
  slug                String        @unique
  metaDescription     String?       @db.Text
  statut              ArticleStatus @default(BROUILLON)
  datePublication     DateTime?
  datePlanification   DateTime?
  categorieId         String        @db.Uuid
  imageCouvertureUrl  String?
  imageCouverturePublicId String?
  auteurId            String        @db.Uuid
  publishedByAdminId  String?       @db.Uuid
  deletedAt           DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  categorie        Categorie       @relation(fields: [categorieId], references: [id], onDelete: Restrict)
  auteur           AdminProfile    @relation("ArticleAuthor", fields: [auteurId], references: [id], onDelete: Restrict)
  publishedByAdmin AdminProfile?   @relation("ArticlePublication", fields: [publishedByAdminId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([categorieId])
  @@index([statut])
  @@index([auteurId])
  @@index([datePublication])
  @@index([deletedAt])
  @@map("articles")
}

// ---------------------------------------------------------------------------
// Commandes
// ---------------------------------------------------------------------------

model Commande {
  id             String             @id @default(uuid()) @db.Uuid
  dateCreation   DateTime           @default(now())
  statut         OrderStatus        @default(COMMANDE)
  montantTotal   Decimal            @db.Decimal(12, 0)
  commission     Decimal            @default(0) @db.Decimal(12, 0)
  typeCommande   OrderType          @default(STANDARD)
  fraisLivraison Decimal            @default(0) @db.Decimal(12, 0)
  acheteurId     String             @db.Uuid
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  acheteur           BuyerProfile      @relation(fields: [acheteurId], references: [id], onDelete: Restrict)
  lignesCommande     LigneCommande[]
  commandesArtisans  CommandeArtisan[]
  paiement           Paiement?
  livraison          Livraison?
  avis               Avis?
  litiges            Litige[]

  @@index([acheteurId])
  @@index([statut])
  @@map("commandes")
}

model LigneCommande {
  id                 String           @id @default(uuid()) @db.Uuid
  commandeId         String           @db.Uuid
  oeuvreId           String           @db.Uuid
  artisanId          String           @db.Uuid // Snapshot du vendeur au moment de la commande; doit rester cohérent avec Oeuvre.artisanId à la création.
  prixUnitaire       Decimal          @db.Decimal(12, 0)
  quantite           Int              @default(1)
  commandeArtisanId  String?          @db.Uuid

  commande        Commande          @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  oeuvre          Oeuvre            @relation(fields: [oeuvreId], references: [id], onDelete: Restrict)
  artisan         ArtisanProfile    @relation(fields: [artisanId], references: [id], onDelete: Restrict)
  commandeArtisan CommandeArtisan?  @relation(fields: [commandeArtisanId], references: [id], onDelete: SetNull)

  @@index([commandeId])
  @@index([oeuvreId])
  @@index([artisanId])
  @@index([commandeArtisanId])
  @@map("ligne_commandes")
}

// ---------------------------------------------------------------------------
// Commande multi-artisans : une CommandeArtisan par artisan dans une commande
// ---------------------------------------------------------------------------

model CommandeArtisan {
  id              String      @id @default(uuid()) @db.Uuid
  commandeId      String      @db.Uuid
  artisanId       String      @db.Uuid
  statut          OrderStatus @default(COMMANDE)
  sousTotal       Decimal     @db.Decimal(12, 0)
  commission      Decimal     @default(0) @db.Decimal(12, 0)
  fraisLivraison  Decimal     @default(0) @db.Decimal(12, 0)
  montantTotal    Decimal     @db.Decimal(12, 0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  commande       Commande         @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  artisan        ArtisanProfile   @relation(fields: [artisanId], references: [id], onDelete: Restrict)
  lignesCommande LigneCommande[]

  @@unique([commandeId, artisanId])
  @@index([commandeId])
  @@index([artisanId])
  @@index([statut])
  @@map("commande_artisan")
}

model Paiement {
  id             String        @id @default(uuid()) @db.Uuid
  montant        Decimal       @db.Decimal(12, 0)
  methode        PaymentMethod
  statut         PaymentStatus @default(EN_ATTENTE)
  date           DateTime      @default(now())
  estEnsequestre Boolean       @default(false)
  commandeId     String        @unique @db.Uuid

  commande Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)

  @@map("paiements")
}

model Livraison {
  id           String         @id @default(uuid()) @db.Uuid
  transporteur String
  numeroSuivi  String?
  statut       DeliveryStatus @default(EN_ATTENTE)
  adresseDest  String
  frais        Decimal        @default(0) @db.Decimal(12, 0)
  commandeId   String         @unique @db.Uuid

  commande Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)

  @@map("livraisons")
}

model Avis {
  id          String   @id @default(uuid()) @db.Uuid
  note        Int
  commentaire String   @db.Text
  dateAvis    DateTime @default(now())
  estVerifie  Boolean  @default(false)
  commandeId  String   @unique @db.Uuid

  commande Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)

  // Contrainte PostgreSQL métier à ajouter dans la migration SQL : note >= 1 AND note <= 5.
  @@map("avis")
}

// ---------------------------------------------------------------------------
// Litiges : centre de résolution des litiges entre clients et artisans
// (Phase 1 : socle conforme maquette Admin, lecteur uniquement)
// ---------------------------------------------------------------------------

enum DisputeStatus {
  OUVERT
  EN_COURS
  RESOLU
}

model Litige {
  id         String        @id @default(uuid()) @db.Uuid
  motif      String        @db.Text
  statut     DisputeStatus @default(OUVERT)
  commandeId String        @db.Uuid
  artisanId  String        @db.Uuid
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  commande Commande       @relation(fields: [commandeId], references: [id], onDelete: Restrict)
  artisan  ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Restrict)

  // Chaque litige concerne UNE commande et UN artisan précis : une commande
  // multi-artisans peut porter plusieurs litiges, chacun rattaché à l'artisan
  // concerné via la colonne artisanId.

  @@index([commandeId])
  @@index([artisanId])
  @@index([statut])
  @@map("litiges")
}

// ---------------------------------------------------------------------------
// Profil Artisan — Photos atelier, Processus, Expositions, Boutique, Paiement
// ---------------------------------------------------------------------------

model ArtisanAtelierPhoto {
  id              String   @id @default(uuid()) @db.Uuid
  artisanId       String   @db.Uuid
  url             String
  publicId        String
  mimeType        String
  size            Int
  ordre           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  artisan ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  @@index([artisanId])
  @@index([artisanId, ordre])
  @@map("artisan_atelier_photos")
}

model CreationProcessus {
  id              String   @id @default(uuid()) @db.Uuid
  artisanId       String   @db.Uuid
  ordre           Int
  photoUrl        String?
  photoPublicId   String?
  photoMimeType   String?
  photoSize       Int?
  legende         String   @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  artisan ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  @@unique([artisanId, ordre])
  @@index([artisanId])
  @@map("creation_processus")
}

model Exposition {
  id              String   @id @default(uuid()) @db.Uuid
  artisanId       String   @db.Uuid
  annee           Int
  evenement       String
  lieu            String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  artisan ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  @@index([artisanId])
  @@index([artisanId, annee])
  @@map("expositions")
}

model BoutiqueSetting {
  id                  String        @id @default(uuid()) @db.Uuid
  artisanId           String        @unique @db.Uuid
  devise              ArtisanDevise @default(XOF)
  langue              ArtisanLangue @default(fr)
  preparationMinDays  Int?
  preparationMaxDays  Int?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  artisan ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  @@map("boutique_settings")
}

model ArtisanPaymentPreference {
  id                    String               @id @default(uuid()) @db.Uuid
  artisanId             String               @unique @db.Uuid
  methode               ArtisanPaiementMethode
  mobileMoneyOperateur  String?
  mobileMoneyNumero     String?
  virementNomBanque     String?
  virementIban          String?
  virementNomCompte     String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  artisan ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  @@map("artisan_payment_preferences")
}
